import personajes.*
import heroes.*
import villanos.*
import elementosDelJuego.*

describe "Tests de Dominio y Visuales: Etapa 3" {

  test "El heroe cambia de posicion y alterna frame de paso al moverse" {
    const heroe = new Heroe(nombre = "Tupac", position = game.at(2, 2))
    assert.equals("Tupac1A.png", heroe.image())
    
    heroe.moverArriba()
    assert.equals(game.at(2, 3), heroe.position())
    assert.equals("Tupac1B.png", heroe.image()) // Alternó a frame B
  }

  test "El villano transformado cambia su imagen al animal correspondiente" {
    const villano = new Villano(nombre = "demoledor", animal = "condor", estaTransformado = true, direccion = norte)
    assert.equals("condor1.png", villano.image())
  }

  test "El proyectil Papa calcula correctamente su imagen segun la direccion" {
    const papaNorte = new Papa(direccion = norte)
    assert.equals("papa1.png", papaNorte.image())

    const papaEste = new Papa(direccion = este)
    assert.equals("papa3.png", papaEste.image())
  }

  test "El cofre cambia de sprite cuando se abre" {
    const cofre = new Cofre()
    assert.equals("cofreC.png", cofre.image())
    cofre.abrir()
    assert.equals("cofre.png", cofre.image())
  }
}
