import personajes.*
import heroes.*
import villanos.*
import elementosDelJuego.*

describe "Tests de HUD y Puzles: Etapa 4" {

  test "El HUD de corazones se actualiza segun las vidas del heroe" {
    const heroe = new Heroe(vidas = 2)
    const corazon1 = new CorazonHUD(indice = 1, personaje = heroe)
    const corazon3 = new CorazonHUD(indice = 3, personaje = heroe)
    
    assert.equals("corazon.png", corazon1.image())
    assert.equals("vacio.png", corazon3.image())
  }

  test "La barra de energia calcula el sprite correcto segun el porcentaje" {
    const heroe = new Heroe(energia = 60)
    const barra = new BarraEnergiaHUD(personaje = heroe)
    assert.equals("energia60.png", barra.image())
  }

  test "El HUD de puntaje formatea a tres digitos" {
    const heroe = new Heroe(puntos = 45)
    const centena = new DigitoPuntajeHUD(indice = 0, personaje = heroe)
    const decena = new DigitoPuntajeHUD(indice = 1, personaje = heroe)
    const unidad = new DigitoPuntajeHUD(indice = 2, personaje = heroe)

    assert.equals("n0.png", centena.image())
    assert.equals("n4.png", decena.image())
    assert.equals("n5.png", unidad.image())
  }

  test "El gestor de niveles pasa fluidamente de Nivel 1 a Nivel 2" {
    const heroe = new Heroe(nombre = "Tupac")
    gestorDeNiveles.configurarNivel1(heroe)
    assert.that(heroe.nivelActual().esNivel1())
    assert.equals("Tupac", heroe.nombre())

    gestorDeNiveles.pasarANivel2(heroe)
    assert.that(heroe.nivelActual().esNivel2())
    assert.equals("Pachita", heroe.nombre())
  }
}
